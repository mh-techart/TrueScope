# Line endings: LF in the repository, native in the working tree.
# This repository is developed on macOS and Windows; without this, the two
# commit the same file differently and diffs show changes that are not changes.
* text=auto

# Source and text formats
*.h        text
*.cpp      text
*.cs       text
*.usf      text
*.ush      text
*.ini      text
*.py       text
*.md       text
*.json     text
*.uplugin  text
*.svg      text

# Binary: never normalise, never diff as text
*.png      binary
*.jpg      binary
*.jpeg     binary
*.gif      binary
*.uasset   binary
*.umap     binary
