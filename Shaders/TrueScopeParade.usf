/*
	GPU parade analysis (M5) — two passes, result stays GPU-resident:

	1. ParadeBinCS: one thread per capture pixel, three InterlockedAdds into a
	   per-channel column x value-bin count buffer. uint atomics only — no
	   float atomics, no wave/subgroup intrinsics (cross-platform parity rule).
	2. ParadeIntensityCS: one thread per output texel, maps counts to display
	   brightness with the LOG density mapping (count -> texel brightness; the
	   linear count -> curve-height mapping is the histogram's, never this
	   one), writing one single-channel density texture per channel — a block
	   physically cannot contain another channel's trace, same as the CPU path.

	Bin buffer layout, identical to FTrueScopeAnalysisResult::Parade with the
	channel as the outer index:
	    [Channel * (Width * NUM_BINS) + Column * NUM_BINS + Bin]

	NUM_BINS and THREADGROUP_SIZE are set by the host code from
	FTrueScopeAnalysisResult::NumBins so shader and CPU layout cannot drift.
*/

#include "/Engine/Public/Platform.ush"

// ---------------------------------------------------------------------------
// Pass 1: binning
// ---------------------------------------------------------------------------

Texture2D<float4> InputTexture;
int2 InputSize;
RWBuffer<uint> ParadeBinsOut;

[numthreads(THREADGROUP_SIZE, THREADGROUP_SIZE, 1)]
void ParadeBinCS(uint3 Thread : SV_DispatchThreadID)
{
	if (any(int2(Thread.xy) >= InputSize))
	{
		return;
	}

	// The capture is 8-bit unorm: Load returns exactly byte / 255, and
	// round-tripping recovers the byte, so the GPU bin index equals the CPU
	// path's byte-valued bin index (the equivalence test pins this).
	const float4 Color = InputTexture.Load(int3(Thread.xy, 0));
	const uint3 Bin = uint3(saturate(Color.rgb) * 255.0 + 0.5);

	const uint ChannelStride = uint(InputSize.x) * NUM_BINS;
	const uint ColumnBase = Thread.x * NUM_BINS;
	InterlockedAdd(ParadeBinsOut[0u * ChannelStride + ColumnBase + Bin.r], 1u);
	InterlockedAdd(ParadeBinsOut[1u * ChannelStride + ColumnBase + Bin.g], 1u);
	InterlockedAdd(ParadeBinsOut[2u * ChannelStride + ColumnBase + Bin.b], 1u);
}

// ---------------------------------------------------------------------------
// Pass 2: counts -> per-channel density textures
// ---------------------------------------------------------------------------

Buffer<uint> ParadeBinsIn;
int2 OutputSize;     // (capture width, NUM_BINS)
uint MaxCount;       // max possible count per cell: the capture height
float IntensityGain;
RWTexture2D<float4> RedOut;
RWTexture2D<float4> GreenOut;
RWTexture2D<float4> BlueOut;

// Same log density mapping as TrueScope::CountToIntensity on the CPU path:
// count -> texel BRIGHTNESS, lifting sparse cells into visibility.
float CountToIntensity(uint Count)
{
	if (Count == 0u || MaxCount == 0u)
	{
		return 0.0;
	}
	return log(1.0 + IntensityGain * float(Count)) / log(1.0 + IntensityGain * float(MaxCount));
}

[numthreads(THREADGROUP_SIZE, THREADGROUP_SIZE, 1)]
void ParadeIntensityCS(uint3 Thread : SV_DispatchThreadID)
{
	if (any(int2(Thread.xy) >= OutputSize))
	{
		return;
	}

	// Row 0 = top = highest value bin, matching the CPU intensity image layout.
	const uint Bin = uint(OutputSize.y - 1) - Thread.y;
	const uint ChannelStride = uint(OutputSize.x) * NUM_BINS;
	const uint Cell = Thread.x * NUM_BINS + Bin;

	// One single-channel texture per channel: the intensity goes into exactly
	// the channel's own component, zero elsewhere (no cross-channel bleed).
	RedOut[Thread.xy]   = float4(CountToIntensity(ParadeBinsIn[0u * ChannelStride + Cell]), 0.0, 0.0, 1.0);
	GreenOut[Thread.xy] = float4(0.0, CountToIntensity(ParadeBinsIn[1u * ChannelStride + Cell]), 0.0, 1.0);
	BlueOut[Thread.xy]  = float4(0.0, 0.0, CountToIntensity(ParadeBinsIn[2u * ChannelStride + Cell]), 1.0);
}
