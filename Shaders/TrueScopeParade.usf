/*
	GPU parade + waveform analysis (M5, phase-5.2) — two passes, result stays
	GPU-resident:

	1. ColumnBinCS: one thread per capture pixel, four InterlockedAdds into a
	   per-channel column x value-bin count buffer (R, G, B and BT.709 luma).
	   uint atomics only — no float atomics, no wave/subgroup intrinsics
	   (cross-platform parity rule).
	2. ColumnIntensityCS: one thread per output texel, maps counts to display
	   brightness with the LOG density mapping (count -> texel brightness; the
	   linear count -> curve-height mapping is the histogram's, never this
	   one), writing one single-channel density texture per channel — a block
	   physically cannot contain another channel's trace, same as the CPU
	   path — plus the two full-width waveform traces built from the same
	   counts: RGB (three channel densities superimposed) and Luma (neutral).

	Bin buffer layout, identical to FTrueScopeAnalysisResult::Parade (channels
	0-2) and ::LumaParade (channel 3) with the channel as the outer index:
	    [Channel * (Width * NUM_BINS) + Column * NUM_BINS + Bin]

	NUM_BINS and THREADGROUP_SIZE are set by the host code from
	FTrueScopeAnalysisResult so shader and CPU layout cannot drift; the four
	channel indices below are mirrored by TrueScope::ColumnBinChannels /
	LumaBinChannel in the host code (TrueScopeGpuParade.h).

	The luma binning is INTEGER-EXACT, mirroring TrueScope::PixelToLumaBin
	(TrueScopeColor.cpp) constant for constant — same class of bin-boundary
	instability the vectorscope fixed in phase-5.1: every neutral pixel's luma
	is its own code value, floats land it ON a bin boundary, and CPU-vs-Metal
	FMA/ordering differences flip whole populations between adjacent bins.
*/

#include "/Engine/Public/Platform.ush"

// BT.709 coefficients as exact rationals over 10000 (TrueScopeColor.cpp,
// PixelToLumaBin — keep in lockstep).
#define K_SCALE 10000
#define K_R 2126
#define K_G 7152
#define K_B 722
// Denominator of the luma bin rational for byte-valued pixels.
#define LUMA_DEN (K_SCALE * 255)

// ---------------------------------------------------------------------------
// Pass 1: binning
// ---------------------------------------------------------------------------

Texture2D<float4> InputTexture;
int2 InputSize;
RWBuffer<uint> ColumnBinsOut;

[numthreads(THREADGROUP_SIZE, THREADGROUP_SIZE, 1)]
void ColumnBinCS(uint3 Thread : SV_DispatchThreadID)
{
	if (any(int2(Thread.xy) >= InputSize))
	{
		return;
	}

	// The capture is 8-bit unorm: Load returns exactly byte / 255, and
	// round-tripping recovers the byte, so the GPU bin index equals the CPU
	// path's byte-valued bin index (the equivalence test pins this).
	const float4 Color = InputTexture.Load(int3(Thread.xy, 0));
	const uint3 Byte = uint3(saturate(Color.rgb) * 255.0 + 0.5);

	// Integer-exact luma bin, identical to TrueScope::PixelToLumaBin: rounded,
	// not floored (a neutral pixel of code value v must land in bin v);
	// numerator max ~651M < 2^32, so uint arithmetic is exact.
	const uint LumaN = K_R * Byte.r + K_G * Byte.g + K_B * Byte.b;
	const uint LumaBin = min((LumaN * uint(NUM_BINS - 1) + LUMA_DEN / 2) / LUMA_DEN, uint(NUM_BINS - 1));

	const uint ChannelStride = uint(InputSize.x) * NUM_BINS;
	const uint ColumnBase = Thread.x * NUM_BINS;
	InterlockedAdd(ColumnBinsOut[0u * ChannelStride + ColumnBase + Byte.r], 1u);
	InterlockedAdd(ColumnBinsOut[1u * ChannelStride + ColumnBase + Byte.g], 1u);
	InterlockedAdd(ColumnBinsOut[2u * ChannelStride + ColumnBase + Byte.b], 1u);
	InterlockedAdd(ColumnBinsOut[3u * ChannelStride + ColumnBase + LumaBin], 1u);
}

// ---------------------------------------------------------------------------
// Pass 2: counts -> per-channel parade density textures + waveform traces
//
// The output is the widget's plot rect in DEVICE PIXELS (phase-6.1 Task 1), not
// the bin grid: one raster texel is one device pixel, so Slate draws the raster
// 1:1 and no upscale can thicken or smear it. The bin grid (SourceWidth columns
// x NUM_BINS value bins) is therefore RESAMPLED into that rect here — with the
// clamp-bilinear filter Slate's sampler used to apply, so the image is the one
// the widget drew before, only rasterized at display resolution. Bins and
// counts are untouched: this is a raster-resolution change, nothing else.
//
// The parade and the waveform live in different panels and thus have different
// plot rects, so they are separate dispatches over the same count buffer.
// ---------------------------------------------------------------------------

Buffer<uint> ColumnBinsIn;
int2 OutputSize;     // the target's plot rect, in device pixels
int SourceWidth;     // columns in the count buffer (the capture width)
uint MaxCount;       // max possible count per cell: the capture height
float IntensityGain;
RWTexture2D<float4> RedOut;
RWTexture2D<float4> GreenOut;
RWTexture2D<float4> BlueOut;
RWTexture2D<float4> WaveformRgbOut;
RWTexture2D<float4> WaveformLumaOut;

// Same log density mapping as TrueScope::CountToIntensity on the CPU path:
// count -> texel BRIGHTNESS, lifting sparse cells into visibility.
float CountToIntensity(uint Count)
{
	if (Count == 0u || MaxCount == 0u)
	{
		return 0.0;
	}
	return log(1.0 + IntensityGain * float(Count)) / log(1.0 + IntensityGain * float(MaxCount));
}

float CellIntensity(uint Channel, int Column, int Row)
{
	// Row 0 = top = highest value bin, matching the CPU intensity image layout.
	const uint Bin = uint(NUM_BINS - 1 - Row);
	const uint ChannelStride = uint(SourceWidth) * NUM_BINS;
	return CountToIntensity(ColumnBinsIn[Channel * ChannelStride + uint(Column) * NUM_BINS + Bin]);
}

/**
 * Bilinear sample of a channel's density at an output texel, in clamp
 * addressing — the exact filter Slate's bilinear sampler applied to the old
 * bin-sized texture, evaluated here on the count grid instead. Clamping the
 * grid coordinate (not the two taps) is what makes the edge texels sample the
 * edge cell twice, as the clamp sampler does.
 */
float SampleChannelIntensity(uint Channel, uint2 Texel)
{
	const float ColumnCoord = clamp(
		(float(Texel.x) + 0.5) * float(SourceWidth) / float(OutputSize.x) - 0.5,
		0.0, float(SourceWidth - 1));
	const float RowCoord = clamp(
		(float(Texel.y) + 0.5) * float(NUM_BINS) / float(OutputSize.y) - 0.5,
		0.0, float(NUM_BINS - 1));

	const int Column0 = int(floor(ColumnCoord));
	const int Column1 = min(Column0 + 1, SourceWidth - 1);
	const int Row0 = int(floor(RowCoord));
	const int Row1 = min(Row0 + 1, NUM_BINS - 1);
	const float ColumnFraction = ColumnCoord - float(Column0);
	const float RowFraction = RowCoord - float(Row0);

	const float Top = lerp(CellIntensity(Channel, Column0, Row0), CellIntensity(Channel, Column1, Row0),
		ColumnFraction);
	const float Bottom = lerp(CellIntensity(Channel, Column0, Row1), CellIntensity(Channel, Column1, Row1),
		ColumnFraction);
	return lerp(Top, Bottom, RowFraction);
}

[numthreads(THREADGROUP_SIZE, THREADGROUP_SIZE, 1)]
void ColumnIntensityParadeCS(uint3 Thread : SV_DispatchThreadID)
{
	if (any(int2(Thread.xy) >= OutputSize))
	{
		return;
	}

	const float R = SampleChannelIntensity(0u, Thread.xy);
	const float G = SampleChannelIntensity(1u, Thread.xy);
	const float B = SampleChannelIntensity(2u, Thread.xy);

	// One single-channel texture per parade channel: the intensity goes into
	// exactly the channel's own component, zero elsewhere (no cross-channel
	// bleed).
	RedOut[Thread.xy]   = float4(R, 0.0, 0.0, 1.0);
	GreenOut[Thread.xy] = float4(0.0, G, 0.0, 1.0);
	BlueOut[Thread.xy]  = float4(0.0, 0.0, B, 1.0);
}

[numthreads(THREADGROUP_SIZE, THREADGROUP_SIZE, 1)]
void ColumnIntensityWaveformCS(uint3 Thread : SV_DispatchThreadID)
{
	if (any(int2(Thread.xy) >= OutputSize))
	{
		return;
	}

	// Waveform traces from the same counts (the CPU path's BuildRgbWaveform-
	// Texels / BuildLumaWaveformTexels): RGB superimposes the three channel
	// densities in one full-width plot, Luma is a neutral trace.
	const float R = SampleChannelIntensity(0u, Thread.xy);
	const float G = SampleChannelIntensity(1u, Thread.xy);
	const float B = SampleChannelIntensity(2u, Thread.xy);
	const float L = SampleChannelIntensity(3u, Thread.xy);

	WaveformRgbOut[Thread.xy] = float4(R, G, B, 1.0);
	WaveformLumaOut[Thread.xy] = float4(L, L, L, 1.0);
}
