/*
	GPU vectorscope analysis (phase-5.1 Task 2) — two passes, result stays
	GPU-resident, mirroring the M5 parade pipeline:

	1. VectorBinCS: one thread per capture pixel, BT.709 R'G'B' -> (Cb, Cr)
	   bins (the same math as TrueScope::PixelToChromaBins, on the
	   display-encoded signal — no linearization), one InterlockedAdd into the
	   count grid. uint atomics only — no float atomics, no wave/subgroup
	   intrinsics (cross-platform parity rule).
	2. VectorIntensityCS: one thread per output texel, maps counts to display
	   brightness with the LOG density mapping (count -> texel brightness, the
	   density field — never the linear curve-height mapping), writing white
	   texels that carry the density in ALPHA, exactly like the CPU widget's
	   upload (empty chroma coordinates stay transparent so the graticule shows
	   through).

	Count grid layout, identical to FTrueScopeAnalysisResult::Vectorscope:
	    [CrBin * NUM_VECTOR_BINS + CbBin], bin 0 = -0.5, last bin = +0.5.

	NUM_VECTOR_BINS and THREADGROUP_SIZE are set by the host code from
	FTrueScopeAnalysisResult so shader and CPU layout cannot drift.

	The binning is INTEGER-EXACT, mirroring TrueScope::PixelToChromaBins
	(TrueScopeColor.cpp) constant for constant: the BT.709 coefficients as
	rationals over 10000, evaluated in pure int32 arithmetic. Float chroma must
	not be used here: every neutral pixel's chroma is 0, which sits ON the
	boundary between the two center bins, and float FMA/ordering differences
	between the CPU compiler and the shader compiler flip whole gray-value
	populations between bins in bulk. Integer evaluation makes both paths
	bit-identical by construction; the equivalence test pins the agreement.
*/

#include "/Engine/Public/Platform.ush"

// BT.709 coefficients as exact rationals over 10000 (TrueScopeColor.cpp,
// PixelToChromaBins — keep in lockstep).
#define K_SCALE 10000
#define K_R 2126
#define K_G 7152
#define K_B 722
// Common denominators of the Cb/Cr bin rationals for byte-valued pixels.
#define CB_DEN (255 * 2 * (K_SCALE - K_B))
#define CR_DEN (255 * 2 * (K_SCALE - K_R))

// ---------------------------------------------------------------------------
// Pass 1: binning (Cb, Cr scatter)
// ---------------------------------------------------------------------------

Texture2D<float4> InputTexture;
int2 InputSize;
RWBuffer<uint> VectorBinsOut;

[numthreads(THREADGROUP_SIZE, THREADGROUP_SIZE, 1)]
void VectorBinCS(uint3 Thread : SV_DispatchThreadID)
{
	if (any(int2(Thread.xy) >= InputSize))
	{
		return;
	}

	// The capture is 8-bit unorm: Load returns exactly byte / 255, and
	// round-tripping recovers the byte (the parade pass's proven pattern), so
	// the integer bin math below sees exactly the CPU path's byte values.
	const float4 Color = InputTexture.Load(int3(Thread.xy, 0));
	const int3 Byte = int3(saturate(Color.rgb) * 255.0 + 0.5);

	// Integer-exact bins, identical to TrueScope::PixelToChromaBins: numerator
	// max NUM_VECTOR_BINS * CB_DEN < 2^31, non-negative, so the truncating
	// division is the floor; the +0.5 chroma extreme clamps into the last bin.
	const int NCb = (K_SCALE - K_B) * Byte.b - K_R * Byte.r - K_G * Byte.g;
	const int NCr = (K_SCALE - K_R) * Byte.r - K_G * Byte.g - K_B * Byte.b;
	const uint CbBin = min(uint(NUM_VECTOR_BINS * (NCb + CB_DEN / 2) / CB_DEN), uint(NUM_VECTOR_BINS - 1));
	const uint CrBin = min(uint(NUM_VECTOR_BINS * (NCr + CR_DEN / 2) / CR_DEN), uint(NUM_VECTOR_BINS - 1));

	InterlockedAdd(VectorBinsOut[CrBin * NUM_VECTOR_BINS + CbBin], 1u);
}

// ---------------------------------------------------------------------------
// Pass 2: counts -> density texture (white, density in alpha)
//
// The output is the widget's square plot rect in DEVICE PIXELS (phase-6.1
// Task 1), so one raster texel is one device pixel and Slate draws the raster
// 1:1. The (Cb, Cr) count grid is resampled into that rect with the same
// clamp-bilinear filter Slate's sampler used to apply — bins and counts are
// untouched, only the raster resolution changes.
// ---------------------------------------------------------------------------

Buffer<uint> VectorBinsIn;
int2 OutputSize;     // the vectorscope's plot square, in device pixels
uint MaxCount;       // max possible count per cell: the whole frame's pixel count
float IntensityGain;
RWTexture2D<float4> VectorscopeOut;

// Same LINEAR density mapping as TrueScope::CountToIntensity on the CPU path
// (M6.3), hard-clipped at white. MaxCount stays the vectorscope's own basis —
// the whole frame's pixel count, since a flat neutral frame really does put
// every pixel on one chroma coordinate — so only the curve family changed;
// IntensityGain is the vectorscope's effective Trace Brightness.
float CountToIntensity(uint Count)
{
	if (Count == 0u || MaxCount == 0u || IntensityGain <= 0.0)
	{
		return 0.0;
	}
	return min(float(Count) * IntensityGain / float(MaxCount), 1.0);
}

float CellIntensity(int Column, int Row)
{
	// Row 0 = top = highest Cr, matching the CPU intensity image layout.
	const uint CrBin = uint(NUM_VECTOR_BINS - 1 - Row);
	return CountToIntensity(VectorBinsIn[CrBin * NUM_VECTOR_BINS + uint(Column)]);
}

/** Clamp-bilinear sample of the count grid at an output texel (see the header). */
float SampleIntensity(uint2 Texel)
{
	const float CbCoord = clamp(
		(float(Texel.x) + 0.5) * float(NUM_VECTOR_BINS) / float(OutputSize.x) - 0.5,
		0.0, float(NUM_VECTOR_BINS - 1));
	const float RowCoord = clamp(
		(float(Texel.y) + 0.5) * float(NUM_VECTOR_BINS) / float(OutputSize.y) - 0.5,
		0.0, float(NUM_VECTOR_BINS - 1));

	const int Column0 = int(floor(CbCoord));
	const int Column1 = min(Column0 + 1, NUM_VECTOR_BINS - 1);
	const int Row0 = int(floor(RowCoord));
	const int Row1 = min(Row0 + 1, NUM_VECTOR_BINS - 1);
	const float ColumnFraction = CbCoord - float(Column0);
	const float RowFraction = RowCoord - float(Row0);

	const float Top = lerp(CellIntensity(Column0, Row0), CellIntensity(Column1, Row0), ColumnFraction);
	const float Bottom = lerp(CellIntensity(Column0, Row1), CellIntensity(Column1, Row1), ColumnFraction);
	return lerp(Top, Bottom, RowFraction);
}

[numthreads(THREADGROUP_SIZE, THREADGROUP_SIZE, 1)]
void VectorIntensityCS(uint3 Thread : SV_DispatchThreadID)
{
	if (any(int2(Thread.xy) >= OutputSize))
	{
		return;
	}

	VectorscopeOut[Thread.xy] = float4(1.0, 1.0, 1.0, SampleIntensity(Thread.xy));
}
